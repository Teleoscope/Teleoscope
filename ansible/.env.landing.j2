# .env — generated by Ansible for the landing-only EC2 Docker Compose stack.
# Re-generate: ansible-playbook -i vars/inventory.yaml ansible/deploy-landing.yaml
# Do not edit manually on the server; edit vars/vars.yaml and re-run.

NODE_ENV=production
NEXTAUTH_URL=https://{{ teleoscope.ca }}
NEXTAUTH_SECRET={{ nextauth_secret }}
TELEOSCOPE_BASE_URL=https://{{ teleoscope.ca }}
NEXT_PUBLIC_PRODUCT_BASE_URL={% if (landing_product_route_mode | default('proxy')) == 'redirect' %}{{ product_base_url | default('') }}{% endif %}

{% if loops_api_key is defined and loops_api_key %}
LOOPS_API_KEY={{ loops_api_key }}
{% endif %}
{% if next_mailchimp_url is defined and next_mailchimp_url %}
NEXT_MAILCHIMP_URL={{ next_mailchimp_url }}
{% endif %}
{% if health_auth_user is defined and health_auth_user %}
HEALTH_AUTH_USER={{ health_auth_user }}
{% endif %}
{% if health_auth_pass is defined and health_auth_pass %}
HEALTH_AUTH_PASS={{ health_auth_pass }}
{% endif %}
